# Binaries
**/bin/
**/*.exe
**/*.exe~
**/*.dll
**/*.so
**/*.dylib

# Test binary, built with `go test -c`
**/*.test

# Output of the go coverage tool
**/*.out

# Dependency directories
vendor/

# Go workspace file
go.work

# Environment files
.env
.env.local
.env.*.local

# Firebase config & credentials (contains API keys & private keys)
firebase-credentials.json
**/firebase-credentials.json
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist

# IDE
.idea/
.vscode/
*.swp
*.swo

# Build artifacts
*.o
*.a

# Release signing material — never commit
*.jks
*.keystore
key.properties
