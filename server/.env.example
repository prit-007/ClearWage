IS_DEVELOPMENT=true
DEBUG=true
APP_PORT=127.0.0.1:8081
APP_ENV=local

# pprof profiling (optional). Set to 127.0.0.1:6060 to enable /debug/pprof.
PPROF_ADDR=

# Database Config
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=vivek
DB_PASSWORD=vivek_password
DB_NAME=vivek_db
DB_QUERYSTRING=sslmode=disable

# Connection pool (defaults: 50 open, 10 idle, 30m lifetime, 5m idle time)
DB_MAX_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30
DB_CONN_MAX_IDLE_TIME=5

MIGRATION_DIR=database/migrations

# JWT
JWT_SECRET=ThisIsKey
TOKEN_TTL=720  # hours; default 720 (30 days)

# Firebase Auth (Phone Auth)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_PROJECT_ID=workforce-9b7de

# Cloudinary (profile photos + KYC document uploads). Leave empty to fall back to local ./uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server tuning (defaults shown)
# READ_TIMEOUT_SECONDS=10
# WRITE_TIMEOUT_SECONDS=10
# IDLE_TIMEOUT_SECONDS=30
# READ_HEADER_TIMEOUT_SECONDS=5
# BODY_LIMIT_MB=5
# UPLOAD_LIMIT_MB=5
# RATE_LIMIT_PER_MINUTE=100
# AUTH_RATE_LIMIT_PER_MINUTE=20

# pprof basic auth (optional; required when PPROF_ADDR is set)
# PPROF_PASSWORD=

# Metrics endpoint (optional; set to true to enable /metrics)
# METRICS_ENABLED=false
